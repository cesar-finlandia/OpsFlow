{
  "version": "1.0.0",
  "base_url": "http://localhost:5173",
  "data_source": {
    "kind": "cache",
    "cache_key": "opsflow-golden"
  },
  "viewport": {
    "width": 1280,
    "height": 720,
    "device_scale_factor": 2
  },
  "video": {
    "enabled": true,
    "codec": "vp9",
    "size": {
      "width": 1280,
      "height": 720
    }
  },
  "layout": "single-focus",
  "theme": null,
  "steps": [
    {
      "id": "batch-goal",
      "description": "Set goal: hold all low-stock blue variants under $12 shipping to zone 4 for 15 minutes",
      "actions": [
        {
          "action": "navigate",
          "value": "/",
          "timeout_ms": 5000
        },
        {
          "action": "wait_for",
          "selector": "getByRole('heading', {name: 'OpsFlow'})",
          "timeout_ms": 3000
        },
        {
          "action": "fill",
          "selector": "[data-testid='goal-input']",
          "value": "hold all low-stock blue variants under $12 shipping to zone 4 for 15 minutes"
        },
        {
          "action": "click",
          "selector": "getByRole('button', {name: 'Run batch'})",
          "timeout_ms": 3000
        },
        {
          "action": "screenshot",
          "selector": null
        }
      ],
      "wait_after_ms": 1200
    },
    {
      "id": "search-inventory",
      "description": "search_inventory blue inStockOnly false limit 25",
      "actions": [
        {
          "action": "wait_for",
          "selector": "[data-testid='tool-search_inventory'] >> nth=0",
          "timeout_ms": 4000
        },
        {
          "action": "screenshot",
          "selector": null
        }
      ],
      "wait_after_ms": 400
    },
    {
      "id": "filter-variants",
      "description": "filter_variants color Blue maxPrice 1200 low_stock 1-5",
      "actions": [
        {
          "action": "wait_for",
          "selector": "[data-testid='tool-filter_variants'] >> nth=0",
          "timeout_ms": 4000
        },
        {
          "action": "screenshot",
          "selector": null
        }
      ],
      "wait_after_ms": 400
    },
    {
      "id": "calculate-shipping",
      "description": "calculate_shipping 4 SKUs zone 4 ground weight 4831",
      "actions": [
        {
          "action": "wait_for",
          "selector": "[data-testid='tool-calculate_shipping'] >> nth=0",
          "timeout_ms": 4000
        },
        {
          "action": "screenshot",
          "selector": null
        }
      ],
      "wait_after_ms": 400
    },
    {
      "id": "hold-order",
      "description": "hold_order 4 SKUs ttl 15 note demo batch",
      "actions": [
        {
          "action": "wait_for",
          "selector": "[data-testid='tool-hold_order'] >> nth=0",
          "timeout_ms": 4000
        },
        {
          "action": "wait_for",
          "selector": "[data-testid='confirm-action']",
          "timeout_ms": 4000
        },
        {
          "action": "click",
          "selector": "[data-testid='confirm-action']",
          "timeout_ms": 3000
        },
        {
          "action": "wait_ms",
          "value": "1000"
        },
        {
          "action": "screenshot",
          "selector": null
        }
      ],
      "wait_after_ms": 800
    },
    {
      "id": "confirm-fulfillment",
      "description": "confirm_fulfillment HOLD-ABCD1234",
      "actions": [
        {
          "action": "wait_for",
          "selector": "[data-testid='co-timeline']",
          "timeout_ms": 3000
        },
        {
          "action": "wait_ms",
          "value": "800"
        },
        {
          "action": "screenshot",
          "selector": null
        }
      ],
      "wait_after_ms": 300
    }
  ]
}
