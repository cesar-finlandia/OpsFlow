# OpsFlow — what reaches the public repository (MAN-04)
#
# MAN-04 requires "all source/assets/instructions" plus a detectable licence.
# It does not require the private tooling that produced the work, gigabytes of
# generated capture output, or machine-local state. Everything ignored below is
# one of: a secret, a build product, a dependency tree, local scratch state, or
# an artifact of the run_sweep.sh authoring harness.

# ---------------------------------------------------------------------------
# Secrets — never committed (NFR-01, MAN-04, risk R8)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*-service-account*.json
gcp-credentials*.json

# Vercel — local project link, contains org/project ids
.vercel/

# ---------------------------------------------------------------------------
# Dependencies and build output
# ---------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
*.tsbuildinfo

# Python bytecode (the chassis cost module is Python)
__pycache__/
*.py[cod]
.venv/
venv/

# ---------------------------------------------------------------------------
# Test and verification output
# ---------------------------------------------------------------------------
# Playwright E2E artifacts — regenerated by `npm run test:e2e`
test-results/
playwright-report/
reports/e2e/
blob-report/
.playwright/

# Chassis check reports — keep the two committed as submission evidence
reports/*
!reports/doctor/
!reports/doctor/doctor-report.json
!reports/bench/
!reports/bench/*.json

coverage/
.nyc_output/

# ---------------------------------------------------------------------------
# Caches — keep only the golden-cache seeds (DP-SEED, §2.10 row 30), which the
# offline rehearsal and the degraded replay path depend on.
# ---------------------------------------------------------------------------
.cache/*
!.cache/golden/
.vite/
.turbo/

# ---------------------------------------------------------------------------
# Generated capture output
# ---------------------------------------------------------------------------
# demodrive writes a timestamped directory of .webm recordings per attempt
# (~50 MB and growing). The submitted demo lives on YouTube (MAN-06); these raw
# captures are working files, not deliverables.
assets/demodrive/

# Duplicate of architecture-summary.md emitted by the same generator.
architecture_summary.txt

# ---------------------------------------------------------------------------
# run_sweep.sh authoring harness
# ---------------------------------------------------------------------------
# The implementation was driven by run_sweep.sh, a local multi-agent driver.
# It and everything it reads or writes is authoring tooling for one machine —
# session ids, agent handouts, conversation journals, driver logs, per-step
# summaries and lock directories. None of it is part of the product, none of it
# is reproducible for anyone else, and some of it embeds absolute local paths.
# AI assistance is disclosed properly in disclosure.md (MAN-09) instead.

# the driver itself and its configuration
run_sweep.sh
run_planner.conf
run_sequential.conf
run_sequential_md.conf
models.json

# driver state and lock (run_sweep.sh: STATE_FILE, LOCK_DIR)
run_state.json
.run_sweep/
.run_sweep.lock/

# control-plane and inter-agent messaging (CONTROL_DIR, MSG_DIR)
.control/
.intramessages/

# agent session bookkeeping (PI_SESSION_DIR, SID_LIST_FILE, CHAT_DIR)
.pi_sessions/
.chat/
.step_sids.tmp

# supervisor (SUPERVISOR_DIR, SUPERVISOR_LOG)
.supervisor/
supervisor.log

# per-step summaries and records (SUMMARY_DIR, STEP_RECORDS_FILE)
.run_summaries/
.run_step_records.txt

# sequence-mode logs and results (LOG_FILE, RESULTS_FILE)
.sequential_run.log
.sequential_results.txt

# planner-mode logs, results and the per-module prompt snapshots
# (PLANNER_LOG_FILE, PLANNER_RESULTS_FILE, .planner_prompt_<module>[_resume].md)
.planner_run.log
.planner_results.txt
.planner_prompt_*.md

# agent handouts and in-flight prompt (HANDOVER_FILE, CHAT_FLIGHT_FILE)
handout.md
handout_active.md
.prompt_flight.md

# driver/agent stdout and debug streams (DRIVER_LOG, _run.log, DEBUG_FILE)
_driver.log
_run.log
.debug_run.log

# status report the driver rewrites each step (STATUS_REPORT_FILE)
status_report.md

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

.vercel
.env*

# ---------------------------------------------------------------------------
# Authoring docs — local planning material, not part of the product
# ---------------------------------------------------------------------------
design_documents/
