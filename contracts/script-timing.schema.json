{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chassis/contracts/script-timing.schema.json",
  "title": "ScriptTiming",
  "description": "Timing config for SCRIPT pitch video — version + total_minutes + sections",
  "type": "object",
  "required": ["version", "sections"],
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "total_minutes": { "type": ["number", "null"], "minimum": 0.1, "maximum": 10 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["id", "title", "minutes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "minutes": { "type": "number", "minimum": 0.05, "maximum": 10 },
          "live": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
