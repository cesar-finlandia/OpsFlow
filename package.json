{
  "$comment": "Requirement IDs: RES-REU-01, GOV-MIN-04, XCUT-08 | Minimal chassis scaffold (M01 step 1). Root scripts delegate to the 'resilience' workspace package via the pnpm -F filter, matching the CI commands assumed by DP-A §10.3 (`pnpm -F resilience test:offline`). Node >=20 / Python 3.11+ per master_blueprint.md §6.1.",
  "name": "hackathon-chassis",
  "version": "0.0.0",
  "private": true,
  "$type-note": "ESM repo root: scripts/*.ts compile as NodeNext ESM so import.meta resolves (bench-token-overhead).",
  "type": "module",
  "packageManager": "pnpm@10.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:ui": "vitest run --project ui",
    "test:tools": "vitest run tests/tools",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report reports/e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "demo:offline": "vite-node scripts/demo-offline.ts",
    "doctor": "doctor --manifest assembly.manifest.json --json --output reports/doctor/doctor-report.json",
    "eval:plan": "eval --target src/agent/deterministic.ts#planDeterministic --cases tests/eval/plan-cases.json --json --output reports/eval/eval-report.json",
    "track": "track status --json",
    "bench": "bench run --dummy examples/dummy-fixtures/bench/sample_brief.md --manifest assembly.manifest.json --json --output reports/bench/chassis-bench.json",
    "bench:tools": "vite-node scripts/bench-tools.ts --iterations 50 --output reports/bench/bench-report.json",
    "deploy": "npx vercel --prod",
    "deploy:verify": "npx vite-node scripts/deploy-verify.ts",
    "verify:headers": "node scripts/verify-headers.mjs",
    "submit:hygiene": "npx vite-node src/provenance/submit/cli.ts hygiene --manifest assembly.manifest.json --out hygiene-report.json",
    "submit:disclosure": "npx vite-node src/provenance/prov/cli.ts generate --manifest assembly.manifest.json --out disclosure.md",
    "demodrive": "vite-node src/ideation/demodrive/cli.ts",
    "gate": "npx vite-node scripts/gate.ts"
  },
  "bin": {
    "mock": "src/dev/mock/cli.ts",
    "eval": "src/dev/eval/cli.ts",
    "doctor": "src/dev/doctor/cli.ts",
    "track": "src/dev/track/cli.ts",
    "pgm": "src/pgm/cli.ts",
    "profile": "src/profile/cli.ts",
    "provo": "src/provenance/provo/cli.ts",
    "deckgen": "src/ideation/deckgen/cli.ts",
    "deckgen:populate": "src/ideation/deckgen/cli.ts",
    "deckgen:diagram": "src/ideation/deckgen/cli.ts",
    "deckgen:validate": "src/ideation/deckgen/cli.ts",
    "script": "src/ideation/script/cli.ts",
    "script:generate": "src/ideation/script/cli.ts",
    "script:validate": "src/ideation/script/cli.ts",
    "demodrive": "src/ideation/demodrive/cli.ts",
    "demodrive:capture": "src/ideation/demodrive/cli.ts",
    "demodrive:record": "src/ideation/demodrive/cli.ts",
    "faqdef": "src/ideation/faqdef/cli.ts",
    "faqdef:generate": "src/ideation/faqdef/cli.ts",
    "faqdef:gen": "src/ideation/faqdef/cli.ts",
    "faqdef:rehearse": "src/ideation/faqdef/cli.ts",
    "chassis": "scripts/chassis.ts"
  },
  "$codegen-note": "TRN-01/06 codegen tools per DP-B §3.4: json-schema-to-typescript (npm devDep above) + datamodel-codegen (Python CLI on PATH; pip install datamodel-code-generator — not an npm dep by nature).",
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vercel/node": "^10.0.0",
    "jsdom": "^25.0.1",
    "json-schema-to-typescript": "^15.0.4",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}